# Токен бота (получается при создании бота в Mail.ru MyTeam)
BOT_TOKEN=your_bot_token_here

# ID канала (stamp), куда бот должен слать сообщения
CHANNEL_ID=your_channel_id_here

# Base URL сервера llama.cpp
LLM_API_URL=http://192.168.1.35:5003

# Интервал опроса /health (секунды)
HEALTH_CHECK_INTERVAL=30

# Интервал опроса /metrics (секунды)
METRICS_CHECK_INTERVAL=10

# Таймаут стабильности (секунды) — сколько секунд ждать перед уведомлением "LLM свободна"
STABILITY_TIMEOUT=10

# Кулдаун для сообщений о недоступности (секунды)
COOLDOWN_PERIOD=300

# Таймаут HTTP запросов (секунды)
HTTP_TIMEOUT=5

# Количество попыток HTTP запроса
HTTP_RETRIES=3

# Dry-run режим (1 = только логирование, 0 = реальная отправка)
DRY_RUN=0
